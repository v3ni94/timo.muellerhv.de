---
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Fragen und Antworten' } = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="section-head"><h2>{title}</h2></div>
    <div class="faq prose">
      {items.map((i) => (
        <details>
          <summary>{i.q}</summary>
          <div class="faq-body"><p>{i.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

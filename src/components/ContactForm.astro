---
import { SITE } from '../data/site';
/**
 * Kontaktformular (docs/DESIGN-SPEC-V2.md 6.13, Masterprompt Abschnitt 12).
 * Postet ohne JavaScript direkt an /api/contact.php (303 auf /danke/ bei Erfolg, HTML-Fehlerseite bei Fehlern).
 * Mit JavaScript wird per fetch gesendet und die Antwort inline angezeigt.
 * Die Felder sind in zwei fieldset gruppiert (Ihre Kontaktdaten, Ihr Anliegen). Honeypot, Zeitstempel,
 * Datenschutzhinweis, Button, Status und Fallback stehen ausserhalb der Fieldsets.
 * Feldkatalog, Namen, ids, Validierung und fetch-Logik sind unveraendert; der Endpunkt liest dieselben Felder.
 * Das Feld Rolle traegt seine Beispiele als Hinweiszeile (h-rolle) statt als Platzhalter, der auf schmalen Feldern abgeschnitten wurde.
 */
---
<form id="formular" class="contact-form" method="post" action="/api/contact.php" novalidate data-contact-form>
  <fieldset class="form-fieldset">
    <legend>Ihre Kontaktdaten</legend>
    <div class="form-grid">
      <div class="form-field">
        <label for="f-name">Name <span aria-hidden="true">*</span></label>
        <input id="f-name" name="name" type="text" required autocomplete="name" maxlength="120" />
        <span class="form-error" id="e-name" hidden></span>
      </div>
      <div class="form-field">
        <label for="f-email">E-Mail-Adresse <span aria-hidden="true">*</span></label>
        <input id="f-email" name="email" type="email" required autocomplete="email" maxlength="200" inputmode="email" />
        <span class="form-error" id="e-email" hidden></span>
      </div>
      <div class="form-field">
        <label for="f-unternehmen">Unternehmen <span class="hint">(optional)</span></label>
        <input id="f-unternehmen" name="unternehmen" type="text" autocomplete="organization" maxlength="160" />
      </div>
      <div class="form-field">
        <label for="f-rolle">Rolle <span class="hint">(optional)</span></label>
        <input id="f-rolle" name="rolle" type="text" autocomplete="organization-title" maxlength="120" aria-describedby="h-rolle" />
        <span class="hint" id="h-rolle">z. B. Geschäftsführung oder Asset Management</span>
      </div>
      <div class="form-field">
        <label for="f-telefon">Telefonnummer <span class="hint">(optional)</span></label>
        <input id="f-telefon" name="telefon" type="tel" autocomplete="tel" maxlength="40" inputmode="tel" />
      </div>
      <div class="form-field">
        <label for="f-bestand">Ungefähre Bestandsgröße <span class="hint">(optional)</span></label>
        <select id="f-bestand" name="bestand" aria-describedby="h-bestand">
          <option value="">Keine Angabe</option>
          <option value="unter 500 Einheiten">unter 500 Einheiten</option>
          <option value="500 bis unter 2.000 Einheiten">500 bis unter 2.000 Einheiten</option>
          <option value="2.000 bis unter 10.000 Einheiten">2.000 bis unter 10.000 Einheiten</option>
          <option value="10.000 Einheiten und mehr">10.000 Einheiten und mehr</option>
        </select>
        <span class="hint" id="h-bestand">Eine grobe Einordnung reicht. Vertrauliche Portfolio- oder Mieterdaten bitte nicht übermitteln.</span>
      </div>
    </div>
  </fieldset>

  <fieldset class="form-fieldset">
    <legend>Ihr Anliegen</legend>
    <div class="form-field form-field--full">
      <label for="f-anliegen">Beschreibung Ihres Anliegens <span aria-hidden="true">*</span></label>
      <textarea id="f-anliegen" name="anliegen" required minlength="20" maxlength="4000" rows="7" placeholder="Ausgangslage, Ziel und was Sie besprechen möchten."></textarea>
      <span class="form-error" id="e-anliegen" hidden></span>
    </div>
  </fieldset>

  <!-- Spamabwehr: Honeypot (fuer Menschen unsichtbar) und Zeitstempel -->
  <div class="hp-field" aria-hidden="true">
    <label for="f-website">Website</label>
    <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="ts" value="" data-ts />

  <p class="small form-privacy">
    Mit dem Absenden werden Ihre Angaben an die Hausverwaltung Müller GmbH übermittelt und ausschließlich zur Bearbeitung Ihrer Anfrage verwendet.
    Einzelheiten in der <a href="/datenschutz/#kontakt">Datenschutzerklärung</a>. Pflichtfelder sind mit * gekennzeichnet.
  </p>

  <button class="btn btn--primary" type="submit" data-submit>Anfrage an Timo Müller senden</button>
  <div class="form-status" role="status" aria-live="polite" hidden data-status></div>
  <p class="small form-fallback">Alternativ direkt per E-Mail an <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
</form>

<style>
  .contact-form { max-width: 52rem; }
  .form-fieldset:last-of-type { margin-bottom: var(--s-4); }
  .form-privacy { margin-block: var(--s-5); color: var(--c-text-2); }
  .form-fallback { margin-top: var(--s-4); color: var(--c-text-2); }
  .contact-form[aria-busy="true"] .btn { opacity: .7; pointer-events: none; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const ts = form.querySelector<HTMLInputElement>('[data-ts]');
    if (ts) ts.value = String(Math.floor(Date.now() / 1000));
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const mail = 'timo@muellerhv.de';

    const showError = (id: string, msg: string) => {
      const el = document.getElementById('e-' + id);
      const input = form.elements.namedItem(id) as HTMLInputElement | null;
      if (el) { el.textContent = msg; el.hidden = !msg; }
      input?.setAttribute('aria-invalid', msg ? 'true' : 'false');
      if (msg && el) input?.setAttribute('aria-describedby', el.id);
      else input?.removeAttribute('aria-describedby');
    };

    const validate = () => {
      let ok = true;
      const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      const anliegen = (form.elements.namedItem('anliegen') as HTMLTextAreaElement).value.trim();
      showError('name', name.length < 2 ? 'Bitte geben Sie Ihren Namen an.' : '');
      showError('email', !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email) ? 'Bitte geben Sie eine gültige E-Mail-Adresse an.' : '');
      showError('anliegen', anliegen.length < 20 ? 'Bitte beschreiben Sie Ihr Anliegen in mindestens 20 Zeichen.' : '');
      ok = name.length >= 2 && /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email) && anliegen.length >= 20;
      if (!ok) form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      return ok;
    };

    const setStatus = (kind: 'erfolg' | 'fehler', html: string) => {
      status.className = 'form-status form-status--' + kind;
      status.innerHTML = html;
      status.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;
      form.setAttribute('aria-busy', 'true');
      status.hidden = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: new FormData(form),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          window.location.assign('/danke/');
          return;
        }
        const msg = (data && typeof data.message === 'string') ? data.message
          : 'Die Anfrage konnte nicht übermittelt werden.';
        setStatus('fehler', `<strong>${msg}</strong> Bitte schreiben Sie mir direkt an <a href="mailto:${mail}">${mail}</a>. Ihre Eingaben bleiben im Formular erhalten.`);
      } catch {
        setStatus('fehler', `<strong>Verbindung nicht möglich.</strong> Bitte versuchen Sie es erneut oder schreiben Sie direkt an <a href="mailto:${mail}">${mail}</a>.`);
      } finally {
        form.removeAttribute('aria-busy');
      }
    });
  }
</script>

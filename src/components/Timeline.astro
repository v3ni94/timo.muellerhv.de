---
/**
 * Stationen im Kapitelmuster (docs/DESIGN-SPEC-V2.md 6.10): Zeitraum links, Titel und Text rechts.
 * Rendert ausschliesslich Stationen mit freigabe === true.
 * Ohne freigegebene Stationen wird nichts ausgegeben (kein Platzhalter in der Produktion).
 */
export interface Station { zeitraum: string; titel: string; text: string; freigabe: boolean }
interface Props {
  stationen: Station[];
  title?: string;
  /** id der section, Standard "stationen" */
  id?: string;
  /** Haarlinie oben (section--linie), Standard true */
  linie?: boolean;
}
const { stationen, title = 'Stationen', id = 'stationen', linie = true } = Astro.props;
const sichtbar = stationen.filter((s) => s.freigabe);
---
{sichtbar.length > 0 && (
  <section class:list={['section', { 'section--linie': linie }]} id={id}>
    <div class="container">
      <div class="section-head"><h2>{title}</h2></div>
      <ol class="timeline" role="list">
        {sichtbar.map((s) => (
          <li class="kapitel">
            <div class="kapitel__kopf sticky-rand">
              <span class="tl-zeit">{s.zeitraum}</span>
            </div>
            <div class="kapitel__text">
              <h3>{s.titel}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

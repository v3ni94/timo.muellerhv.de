            {berichtsaufbau.map((b) => (<li><h3>{b.t}</h3><p>{b.d}</p></li>))}
          </ol>
          <p class="bildunterschrift">Schematische Struktur. Kein Beispielbericht, keine Werte. Gremienvorlagen folgen den Formaten Ihres Hauses.</p>

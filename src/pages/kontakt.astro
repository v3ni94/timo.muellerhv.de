---
/**
 * Kontakt (docs/DESIGN-SPEC-V2.md 6.13 und 9.4; docs/CONTENT-PLAN-V2.md 4.9).
 * Abschnittsfolge: Breadcrumb, Hero kompakt mit H1, Lead und E-Mail-Zeile, Raster 7/4 mit Formular (zwei Fieldsets)
 * links und Aside "Direkt erreichen" rechts (Portrait 2 als 1:1 hell, E-Mail, Hinweis, zwei Saetze zur Vorbereitung
 * plus Link auf den Heimatort /zusammenarbeit/#vorbereitung, Betreiberhinweis; sticky ueber .sticky-rand),
 * Abschnitt "Was nach Ihrer Anfrage passiert" (drei Schritte, Link /zusammenarbeit/). Kein Kasten, nur Linien.
 * Kein Cta, weil die Seite selbst der Kontaktweg ist. Mobil: Formular vor Aside, die E-Mail steht bereits im Hero.
 * Faktenregeln: keine Reaktionszeit (docs/FAKTENLISTE.md, Abschnitt "Ausdruecklich nicht verwendet"; Masterprompt
 * Abschnitt 4 laesst Bearbeitungsfristen offen), keine Kostenaussage, keine Dauer, keine Kapazitaet.
 * Betreiberangaben aus OPERATOR (docs/FAKTENLISTE.md Nr. 1), E-Mail aus SITE (Nr. 4).
 */
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Hero from '../components/Hero.astro';
import Portrait from '../components/Portrait.astro';
import ContactForm from '../components/ContactForm.astro';
import { breadcrumbLd, type Crumb } from '../lib/seo';
import { SITE, OPERATOR } from '../data/site';

const path = '/kontakt/';
const title = 'Kontakt: Portfolio besprechen | Timo Müller';
const description = 'Schildern Sie Ausgangslage und Ziel Ihres Immobilienportfolios. Anfrage per Formular oder E-Mail an timo@muellerhv.de, persönliche Rückmeldung von Timo Müller.';
const crumbs: Crumb[] = [{ name: 'Kontakt', href: path }];

/* ---------------------------------------------------------------------------
   Freigabepunkt (docs/CONTENT-PLAN-V2.md Abschnitt 9, docs/FAKTENLISTE.md).
   Nr. 25: Kostenfreiheit von Erstgespraech und Kurzeinschaetzung. Bis zur Freigabe bleibt es bei "unverbindlich",
   "kostenfrei" entfaellt. Erst nach Freigabe Flag auf true setzen und den freigegebenen Wortlaut eintragen,
   zum Beispiel einen Satz, der an den Schritt Erstgespraech angehaengt wird. Ohne Freigabe rendert nichts.
--------------------------------------------------------------------------- */
const kostenfreiFreigabe: boolean = false;
const kostenfreiText = '';
/** Ein Flag-Inhalt rendert nur, wenn Freigabe vorliegt und ein Wortlaut eingetragen ist. */
const frei = (flag: boolean, text: string): boolean => flag && text.trim().length > 0;
---
<Base title={title} description={description} path={path} ld={[breadcrumbLd(crumbs)]}>
  <Breadcrumb crumbs={crumbs} />

  <Hero
    eyebrow="Kontakt"
    title="Portfolio besprechen"
    lead="Schildern Sie mir kurz Ihre Ausgangslage und Ihr Ziel. Ich melde mich persönlich zurück, und wir klären, ob und in welchem Umfang eine Zusammenarbeit sinnvoll ist. Die Kontaktaufnahme ist unverbindlich und löst keinen Beratungsvertrag aus."
    mail
    compact
  />

  <section class="section kontakt" id="anfrage">
    <div class="container g kontakt-grid">
      <div class="kontakt-formular gc-1-7">
        <h2 class="caps kontakt-formular__titel">Anfrage senden</h2>
        <ContactForm />
      </div>

      <aside class="kontakt-direkt gc-9-12 sticky-rand" aria-labelledby="direkt-h">
        <Portrait nr={2} ratio="1/1" variant="hell" sizes="12rem" widths={[400, 800]} />
        <h2 class="h3" id="direkt-h">Direkt erreichen</h2>
        <p><a class="mail-gross" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p class="small">Anfragen gehen direkt an mich. Ich melde mich persönlich zurück.</p>
        <hr />
        <h3 class="h4">Was hilft für eine erste Einschätzung</h3>
        <p class="small">Es genügen Art und ungefähre Größe des Bestands, Ihre Rolle und Ihr Ziel. Mieterdaten oder vertrauliche Unterlagen sind nicht nötig, Vertraulichkeit wird vor jedem Datenaustausch vereinbart.</p>
        <a class="textlink small kontakt-direkt__link" href="/zusammenarbeit/#vorbereitung">Was Sie vorbereiten können</a>
        <hr />
        <p class="small kontakt-direkt__betreiber">Betreiber dieser Seite: {OPERATOR.firma}, {OPERATOR.strasse}, {OPERATOR.plzOrt}. <a href="/impressum/">Impressum</a></p>
      </aside>
    </div>
  </section>

  <section class="section section--linie ablauf" id="ablauf">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow eyebrow--still">Ablauf</span>
        <h2>Was nach Ihrer Anfrage passiert</h2>
        <p>Drei Schritte bis zur Entscheidung, ob und in welchem Umfang eine Zusammenarbeit sinnvoll ist. Unterlagen brauchen Sie dafür noch nicht.</p>
      </div>
      <ol class="steps" role="list">
        <li>
          <h3>Persönliche Rückmeldung</h3>
          <p>Ihre Anfrage geht direkt an mich. Ich lese sie selbst, melde mich persönlich zurück und schlage einen Termin für ein Erstgespräch vor. Fehlt mir eine Angabe, frage ich nach.</p>
        </li>
        <li>
          <h3>Erstgespräch</h3>
          <p>Telefon oder Video, unverbindlich und ohne Detaildaten oder Mieterdaten.{frei(kostenfreiFreigabe, kostenfreiText) && <> {kostenfreiText}</>} Was wir klären, steht unter <a href="/zusammenarbeit/#ablauf">Zusammenarbeit</a>.</p>
        </li>
        <li>
          <h3>Einschätzung und Mandatsform</h3>
          <p>Ich sage Ihnen, ob und in welchem Umfang ich eine Zusammenarbeit für sinnvoll halte, und schlage eine <a href="/glossar/#mandat">Mandatsform</a> vor, also Art und Umfang des Beratungsauftrags: Portfolio-Check, Umsetzungsbegleitung oder laufendes Sparring als kritischer Austausch zu anstehenden Entscheidungen. Vorschlag, Leistungsumfang und Datentiefe erhalten Sie schriftlich. Die Kontaktaufnahme allein begründet keinen Vertrag.</p>
          <a class="textlink" href="/asset-management-beratung/#mandate">Zu den drei Mandatsformen</a>
        </li>
      </ol>
      <p class="section-foot ablauf__mehr">Den vollständigen Ablauf vom Erstgespräch bis zur Übergabe, den Datenbedarf je Mandatsform, die Regeln zur Vertraulichkeit und die Offenlegung meiner Interessen beschreibe ich auf einer eigenen Seite. <a class="textlink" href="/zusammenarbeit/">Zur Zusammenarbeit</a></p>
    </div>
  </section>
</Base>

<style>
  /* Raster 7/4: Formular links, Aside rechts; unter 861 px eine Spalte in DOM-Reihenfolge */
  .kontakt-grid { align-items: start; }
  .kontakt-formular__titel { margin-bottom: var(--s-5); }

  /* Aside "Direkt erreichen": kein Kasten, 2 px Linie oben, Portrait mit festen Massen (12 rem, 1:1) */
  .kontakt-direkt { background: transparent; border: 0; border-top: var(--rule-strong); padding: var(--s-5) 0 0; }
  .kontakt-direkt .portrait { max-width: 12rem; margin-bottom: var(--s-5); }
  .kontakt-direkt .h3 { margin-bottom: var(--s-3); }
  .kontakt-direkt .h4 { margin-bottom: var(--s-2); }
  .kontakt-direkt p { color: var(--c-text-2); }
  .kontakt-direkt hr { margin: var(--s-5) 0; }
  .mail-gross { font-size: var(--fs-lead); font-weight: 600; color: var(--c-text); word-break: break-all; }
  .kontakt-direkt__link { color: var(--c-text); }   /* Zielhoehe 44 px liefert .textlink global (padding-block 0.65rem, gleich grosser negativer Aussenabstand); eine Seitenueberschreibung des Innenabstands wuerde die Hoehe unterschreiten */
  .kontakt-direkt__betreiber { color: var(--c-text-3); font-size: var(--fs-xs); }

  /* Ablauf: drei Schritte, Textlink im dritten Schritt und Fusszeile mit Link auf den Heimatort */
  .ablauf .steps .textlink { margin-top: calc(var(--s-3) - 0.65rem); }   /* sichtbarer Abstand zum Absatz --s-3; Zielhoehe 44 px und inline-block aus der globalen .textlink-Regel */
  .ablauf .steps p a { color: var(--c-text); }
  .ablauf__mehr { max-width: var(--w-text); }
  .ablauf__mehr .textlink { display: block; width: fit-content; margin-top: calc(var(--s-2) - 0.65rem); }   /* eigene Zeile (Muster .selbstpruefung__schluss der AM-Seite); sichtbarer Abstand --s-2, 0.65rem ist der Innenabstand der Zielflaeche aus .textlink */
</style>

---
import Fachseite from '../layouts/Fachseite.astro';
---
<Fachseite
  path="/ki-immobilienmanagement/"
  title="KI im Immobilienmanagement | Timo Müller"
  description="KI in der Portfoliosteuerung: Dokumentensichtung, Vorgangsbearbeitung, Datenprüfung, Berichtsentwürfe. Kontrollierter Einstieg mit klaren Freigaben."
  h1="KI im Immobilienmanagement"
  eyebrow="Beratung"
  frage="Wo verbessert KI Ihre Portfoliosteuerung messbar, und wo bleibt sie ein Versprechen?"
  intro="KI ist ein Werkzeug innerhalb der Portfoliosteuerung. Richtig eingesetzt liefert sie bessere Daten, schnellere Abläufe und vorbereitete Entscheidungen. Wirtschaftliche Verantwortung und Freigaben bleiben beim Menschen."
  serviceName="Beratung zu KI im Immobilienmanagement"
  serviceType="KI-Beratung Immobilienwirtschaft"
  situationen={[
    { t: 'Dokumente ohne Struktur', d: 'Verträge, Protokolle, Rechnungen und Schriftverkehr liegen verteilt in Postfächern, Ordnern und Systemen. Informationen sind vorhanden, aber nicht verfügbar.' },
    { t: 'Manuelle Datenprüfung', d: 'Plan und Ist, Stammdaten und Abrechnungen werden von Hand abgeglichen. Fehler fallen spät oder gar nicht auf.' },
    { t: 'Aufwendiges Reporting', d: 'Berichte für Eigentümer und Gremien kosten jeden Monat Tage, obwohl die Daten vorliegen.' },
    { t: 'Unklare Erwartungen an KI', d: 'Die Geschäftsleitung soll KI einführen, weiß aber nicht, welcher Prozess sich eignet und welche Risiken bestehen.' },
  ]}
  leistungen={[
    { t: 'Dokumentensichtung und Zuordnung', d: 'Eingehende Dokumente erkennen, klassifizieren, Objekt und Vorgang zuordnen und die wesentlichen Inhalte extrahieren. Ergebnisse werden stichprobenartig geprüft.' },
    { t: 'Strukturierte Vorgangsbearbeitung', d: 'Vorgänge wie Schadensmeldungen, Rechnungen oder Anfragen mit Bearbeitungsstand, Fristen und Zuständigen nachvollziehbar führen. KI schlägt vor, Menschen entscheiden.' },
    { t: 'Datenprüfungen', d: 'Automatisierte Prüfung auf Abweichungen: Plan gegen Ist, Vertrag gegen Abrechnung, Stammdaten gegen Realität. Auffälligkeiten werden zur Prüfung vorgelegt.' },
    { t: 'Berichtsentwürfe', d: 'Entwürfe für Eigentümer- und Gremienberichte aus geprüften Daten, mit nachvollziehbarer Herkunft jeder Zahl. Freigabe durch den Verantwortlichen.' },
    { t: 'Maßnahmenverfolgung', d: 'Beschlossene Maßnahmen mit Verantwortlichen, Terminen und Status verfolgen, Erinnerungen und Abweichungsberichte erzeugen.' },
    { t: 'Einstiegsprüfung vor jeder Automatisierung', d: 'Datenqualität, Zugriffsrechte, Nutzen, Risiken, Datenschutz und menschliche Freigaben werden vor der Einführung geprüft. Ohne belastbare Daten wird nichts automatisiert.' },
  ]}
  ergebnisse={[
    'Bewertete Liste geeigneter Prozesse mit Nutzen, Aufwand und Risiko',
    'Anforderungen an Datenqualität und Zugriffsrechte',
    'Freigabe- und Kontrollkonzept je Anwendungsfall',
    'Pilotplan für einen kontrollierten Einstieg',
    'Kriterien für die Erfolgsmessung',
  ]}
  vorgehen={[
    { t: 'Prozesse bewerten', d: 'Welche Abläufe sind häufig, regelbasiert und datenreich genug für einen sinnvollen Einsatz?' },
    { t: 'Voraussetzungen prüfen', d: 'Datenqualität, Zugriffsrechte, Datenschutz und Verantwortlichkeiten klären.' },
    { t: 'Pilot umsetzen', d: 'Einen begrenzten Anwendungsfall mit klaren Freigaben und Kontrollen einführen.' },
    { t: 'Auswerten und erweitern', d: 'Nutzen messen, Fehlerquellen beseitigen, erst dann den nächsten Prozess angehen.' },
  ]}
  abgrenzung={[
    'Keine automatischen Zahlungs- oder Investitionsentscheidungen. KI bereitet vor, Menschen entscheiden und geben frei.',
    'Eigene Anwendungen entwickle ich als unternehmerischen Hebel für die eigene Gruppe weiter. Ich beschreibe sie in ihrem tatsächlichen Entwicklungsstand und nicht als ausgerolltes Kundenprojekt.',
    'Keine Partner- oder Anbieterempfehlung ohne konkrete Grundlage. Die Werkzeugauswahl folgt dem Anwendungsfall, nicht umgekehrt.',
    'Personenbezogene Daten aus Kontaktformularen oder Mieterakten werden nicht ohne Rechtsgrundlage und Prüfung an KI-Dienste übergeben.',
  ]}
  faq={[
    { q: 'Welche Prozesse eignen sich für den Einstieg?', a: 'Häufige, regelbasierte Abläufe mit vorhandenen Daten: Dokumentenzuordnung, Rechnungsprüfung, Plan-Ist-Abgleiche, Berichtsentwürfe. Ungeeignet sind Einzelfallentscheidungen mit hoher wirtschaftlicher Tragweite.' },
    { q: 'Ersetzt KI die Verwaltung oder das Asset Management?', a: 'Nein. Sie entlastet von Routinearbeit und verbessert die Informationsbasis. Verantwortung, Bewertung und Entscheidung bleiben bei den Menschen.' },
    { q: 'Wie wird der Datenschutz berücksichtigt?', a: 'Vor jedem Einsatz werden Rechtsgrundlage, Auftragsverarbeitung, Speicherort und Zugriffsrechte geprüft. Wo die Grundlage fehlt, wird der Prozess nicht automatisiert oder anonymisiert umgesetzt.' },
    { q: 'Finanziert KI Projekte oder garantiert sie Einsparungen?', a: 'Nein. KI verbessert Daten, Abläufe und Entscheidungsvorbereitung. Wirtschaftliche Wirkung entsteht erst durch die Entscheidungen, die daraus folgen.' },
  ]}
  verwandt={[
    { label: 'Property-Management-Optimierung', href: '/property-management-optimierung/' },
    { label: 'Portfoliooptimierung', href: '/portfoliooptimierung/' },
    { label: 'Asset-Management-Beratung', href: '/asset-management-beratung/' },
  ]}
/>

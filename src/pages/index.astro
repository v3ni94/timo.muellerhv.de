---
/**
 * Startseite (docs/DESIGN-SPEC-V2.md 6.2 bis 6.7 und 9.1, docs/CONTENT-PLAN-V2.md 4.1).
 * Abschnittsfolge: Hero 7/5 mit Portrait 1, Fakten-Band, Ausgangslagen (#ausgangslagen), Fuer wen (#fuer-wen),
 * Beratung mit Vertiefungen (#beratung, Flaeche), Arbeitsweise (#arbeitsweise), Persoenlicher Ansatz (#ansatz),
 * KI (#ki), Szenario "So wuerde ich vorgehen" (#vorgehen, Flaeche), Einblicke (bedingt, #einblicke), Cta.
 * Zwei Flaechen (Beratung, Szenario), ein dunkler Abschnitt (Cta).
 * Alle Aussagen zur Person stammen aus docs/FAKTENLISTE.md (Nr. 5 bis 10). Keine Zahlen zu Bestand, Mandaten oder Zeitraeumen.
 * Der Wortlaut des Abschnitts "Fuer wen" ist Teil der allgemeinen Textfreigabe (Freigabepunkt 35) und darf gebaut werden.
 */
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Portrait from '../components/Portrait.astro';
import Szenario from '../components/Szenario.astro';
import { SITE } from '../data/site';
import { glossarHref } from '../data/glossar';
import { veroeffentlichteBeitraege, formatDatum } from '../lib/einblicke';

const title = 'Timo Müller | Asset Management & Portfoliooptimierung';
const description = 'Beratung für Immobilienbestandshalter und Investoren: Portfolios analysieren, Potenziale priorisieren und Veränderungen umsetzen. Kontakt zu Timo Müller.';

/* Flag: Belegte Referenzfaelle (docs/FAKTENLISTE.md Nr. 16, Status offen). Erst mit Freigabe schaltet die
   Szenario-Komponente die Fallstudienfelder frei; dann sind zeitraum, ergebnis und messmethode zu ergaenzen. */
const referenzfallFreigabe = false;

const fakten = [
  { t: 'Eigentümerperspektive', d: 'Ich halte selbst Immobilien und entscheide über Investitionen mit eigenem Kapital.' },
  { t: 'Unternehmerische Verantwortung', d: 'Vorstand der Müller Holding AG und Geschäftsführer mehrerer Unternehmen, darunter die Hausverwaltung Müller GmbH.' },
  { t: 'Operatives Verständnis', d: 'Verwaltungspraxis und ein operatives Netzwerk mit Bezügen zu Schreinerei, Fenster- und Elementebau sowie Heizung und Sanitär.' },
];

const ausgangslagen = [
  { t: 'Unklare Investitionsprioritäten', d: 'Instandhaltung, Modernisierung und Nachverdichtung, also zusätzlicher Wohnraum auf bereits bebauten Grundstücken, konkurrieren um Budget, ohne dass die Reihenfolge wirtschaftlich begründet ist.' },
  { t: 'Leerstände ohne abgestimmte Maßnahmen', d: 'Einheiten stehen länger leer als nötig, weil Vermietung, Technik und Budgetfreigabe nicht ineinandergreifen.' },
  { t: 'Unterschiedliche Datenstände', d: 'Verwaltung, Buchhaltung und Eigentümer arbeiten mit abweichenden Zahlen. Entscheidungen werden dadurch verzögert oder auf unsicherer Basis getroffen.' },
  { t: 'Stockende Dienstleisterprozesse', d: 'Aufträge, Nachträge und Abnahmen laufen ohne klare Verantwortung. Kosten und Termine geraten aus dem Blick.' },
  { t: 'Entscheidungen, die im Tagesgeschäft versanden', d: 'Beschlüsse sind gefasst, aber niemand hält Umsetzung, Wirkung und Abweichungen nach.' },
];

/* Rollen: Family Office und Bestandshalter werden beim ersten Auftreten erlaeutert und auf das Glossar verlinkt
   (Masterprompt 3, Inhaltsplan 1.3 und 6.4). Segmente mit href rendern als Inline-Link im Absatz. */
type Segment = string | { t: string; href: string };
const rollen: { t: string; d: Segment[] }[] = [
  {
    t: 'Eigentümer und Family Offices mit größerem Bestand',
    d: [
      'Sie halten Wohnimmobilien im eigenen Vermögen oder steuern sie in einem ',
      { t: 'Family Office', href: glossarHref('family-office') },
      ', also in der Vermögensverwaltung einer oder weniger Familien. Je Objekt fragen Sie: Halten, Entwickeln oder Verkaufen? Ich bringe die Eigentümerperspektive ein und begründe die Antwort wirtschaftlich.',
    ],
  },
  {
    t: 'Geschäftsführungen und Vorstände von Bestandshaltern',
    d: [
      'Als ',
      { t: 'Bestandshalter', href: glossarHref('bestandshalter') },
      ' hält Ihr Unternehmen Immobilien langfristig im eigenen Vermögen. Sie verantworten das Ergebnis und fragen: Wo hilft ein Blick von außen mit Eigentümerperspektive? Ich prüfe Bestehendes unabhängig und bereite Entscheidungen vor.',
    ],
  },
  { t: 'Asset- und Portfolio­management-Teams', d: ['Sie steuern den Bestand und fragen: Wie schließen wir die Lücke zwischen Beschluss und Tagesgeschäft? Ich organisiere die Umsetzung mit Verwaltung und Dienstleistern.'] },
  { t: 'Verantwortliche Teams von Immobilienfonds', d: ['Sie berichten an Anleger und fragen: Wie verbinden wir Anlegerfragen mit der operativen Realität? Ich übersetze zwischen Berichtspflicht und Objektebene, ohne Fondsverwaltung zu übernehmen.'] },
];

const angebote = [
  {
    kenn: 'A',
    titel: 'Portfolio-Check und Maßnahmenplan',
    nutzen: 'Sie erhalten eine unabhängige Bestandsaufnahme Ihres Portfolios: wirtschaftliche Entwicklung, Leerstand, Forderungen, Instandhaltung, Datenqualität und Zuständigkeiten.',
    ergebnis: 'Priorisierte Handlungsfelder und ein Maßnahmenplan mit Verantwortlichkeiten.',
    href: '/asset-management-beratung/#portfolio-check',
  },
  {
    kenn: 'B',
    titel: 'Portfoliooptimierung und Umsetzungsbegleitung',
    nutzen: 'Objektstrategien, Abläufe, Investitionsprioritäten, Dienstleistersteuerung und Reporting werden überarbeitet und in die Umsetzung gebracht.',
    ergebnis: 'Abgestimmte Maßnahmen, klare Steuerung und dokumentierter Fortschritt.',
    href: '/portfoliooptimierung/',
  },
  {
    kenn: 'C',
    titel: 'Laufendes Sparring für Eigentümer und Geschäftsleitungen',
    nutzen: 'Sparring heißt hier regelmäßiger, kritischer Austausch zu Portfoliostrategie, Investitionsentscheidungen, Finanzierungsfragen und operativen Engpässen.',
    ergebnis: 'Vorbereitete Entscheidungen, kritische Zweitmeinung und konsequente Nachverfolgung.',
    href: '/asset-management-beratung/#sparring',
  },
];

const vertiefungen = [
  { label: 'Investitionspriorisierung', href: '/investitionspriorisierung/', d: 'Wie Instandhaltung, Modernisierung und Investitionen nach Dringlichkeit, Wirkung und Abhängigkeit in eine begründete Reihenfolge kommen.' },
  { label: 'Dienstleistersteuerung', href: '/dienstleistersteuerung/', d: 'Wie Leistungsbeschreibung, Nachträge und Abnahme so geregelt werden, dass Kosten und Termine im Blick bleiben.' },
  { label: 'Reporting und Kennzahlen', href: '/reporting-und-kennzahlen/', d: 'Wie Berichte aufgebaut sind, die die Fragen der Eigentümerseite beantworten und Entscheidungen auslösen.' },
  { label: 'Zusammenarbeit', href: '/zusammenarbeit/', d: 'Wie ein Mandat vom Erstgespräch bis zur Übergabe abläuft und welche Interessen ich offenlege.' },
];

const schritte = [
  { t: 'Bestand verstehen', d: 'Zahlen, Verträge, Objekte und Zuständigkeiten sichten. Datenlücken benennen statt überspielen.' },
  { t: 'Prioritäten festlegen', d: 'Handlungsfelder nach Wirkung, Aufwand und Risiko ordnen. Gemeinsam entscheiden, was zuerst kommt.' },
  { t: 'Umsetzung organisieren', d: 'Maßnahmen mit Verantwortlichen, Budget und Terminen hinterlegen. Dienstleister und Verwaltung einbinden.' },
  { t: 'Entwicklung nachhalten', d: 'Fortschritt und Wirkung regelmäßig prüfen, Abweichungen erklären und nachsteuern.' },
];

const kiFelder = [
  { t: 'Dokumente strukturieren', d: 'Verträge, Protokolle und Rechnungen zuordnen und auffindbar machen.' },
  { t: 'Abweichungen sichtbar machen', d: 'Plan und Ist bei Kosten, Erträgen und Leerstand automatisch gegenüberstellen.' },
  { t: 'Vorgänge nachvollziehbar bearbeiten', d: 'Bearbeitungsstände, Fristen und offene Punkte lückenlos verfolgen.' },
  { t: 'Berichte vorbereiten', d: 'Entwürfe für Eigentümer- und Gremienberichte aus geprüften Daten erzeugen.' },
];

/* Bedingter Abschnitt: rendert nur mit mindestens einem freigegebenen Beitrag, kein Hinweis auf kommende Beitraege. */
const beitraege = (await veroeffentlichteBeitraege()).slice(0, 3);
---
<Base title={title} description={description} path="/">
  <section class="hero">
    <div class="container g hero__grid">
      <div class="hero__text gc-1-8">
        <span class="eyebrow">Timo Müller | Asset Management &amp; Portfoliooptimierung</span>
        <h1 class="display">Asset-Management-Beratung für Immobilien&shy;portfolios.</h1>
        <p class="standfirst">Wirtschaftlich denken. Klar priorisieren. Veränderungen umsetzen.</p>
        <p class="lead">
          Ich unterstütze Eigentümer, Investoren und Bestandshalter dabei, Immobilienportfolios wirtschaftlich und operativ weiterzuentwickeln.
          Mein Ansatz verbindet die Eigentümerperspektive mit klarer Portfoliosteuerung, praktischem Umsetzungsverständnis und dem gezielten Einsatz von KI.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/kontakt/">Portfolio besprechen</a>
          <a class="textlink" href="#beratung">So unterstütze ich Sie</a>
        </div>
        <p class="hero__mail">Direkt: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
      <div class="hero__media gc-9-12">
        <Portrait nr={1} ratio="4/5" priority sizes="(max-width: 860px) 20rem, (max-width: 1300px) 30vw, 380px" />
      </div>
    </div>
  </section>

  <section class="section section--tight section--linie fakten-band" aria-labelledby="kurzprofil-h">
    <div class="container">
      <h2 id="kurzprofil-h" class="visually-hidden">Kurzprofil</h2>
      <ul class="fakten g" role="list">
        {fakten.map((f, i) => (
          <li class={['gc-1-4', 'gc-5-8', 'gc-9-12'][i]}>
            <strong>{f.t}</strong>
            {f.d}
          </li>
        ))}
      </ul>
      <p class="fakten__link"><a class="textlink small" href="/profil/">Zum Profil</a></p>
    </div>
  </section>

  <section class="section section--linie" id="ausgangslagen">
    <div class="container">
      <div class="abschnitt">
        <div class="abschnitt__kopf sticky-rand">
          <span class="eyebrow eyebrow--still">Ausgangslagen</span>
          <h2>Wenn Potenziale im Bestand nicht in Ergebnisse übersetzt werden.</h2>
          <p>Oft fehlt es nicht an Erkenntnis, sondern an Umsetzung. Typische Situationen, in denen ein unabhängiger Blick von außen hilft:</p>
        </div>
        <div class="abschnitt__inhalt">
          <ol class="register" role="list">
            {ausgangslagen.map((a) => (
              <li>
                <h3>{a.t}</h3>
                <p>{a.d}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--linie" id="fuer-wen">
    <div class="container">
      <div class="abschnitt">
        <div class="abschnitt__kopf sticky-rand">
          <span class="eyebrow eyebrow--still">Für wen</span>
          <h2>Für wen die Beratung gedacht ist.</h2>
          <p>Vier Rollen, vier typische Fragen. Der Schwerpunkt liegt auf größeren Wohnimmobilienbeständen in Deutschland. Fachlich passende kleinere Portfolios sind willkommen.</p>
        </div>
        <div class="abschnitt__inhalt">
          <ol class="register register--2 rollen" role="list">
            {rollen.map((r) => (
              <li>
                <h3>{r.t}</h3>
                <p>{r.d.map((seg) => (typeof seg === 'string' ? seg : <a href={seg.href}>{seg.t}</a>))}</p>
              </li>
            ))}
          </ol>
          <p class="abschnitt__foot"><a class="textlink" href="/asset-management-beratung/#selbstpruefung">Fünf Fragen an Ihr Portfolio</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flaeche" id="beratung">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Beratung</span>
        <h2>Drei Mandatsformen, ein Anspruch: Analyse, Entscheidung und Umsetzung verbinden.</h2>
        <p>Jede Mandatsform ist eigenständig beauftragbar. Umfang und Datentiefe werden vor Beginn vereinbart.</p>
      </div>
      <div class="spalten">
        {angebote.map((a) => (
          <article class="spalte">
            <span class="spalte__kennung" aria-hidden="true">{a.kenn}</span>
            <h3>{a.titel}</h3>
            <p>{a.nutzen}</p>
            <dl class="spalte__dl"><dt>Arbeitsergebnis</dt><dd>{a.ergebnis}</dd></dl>
            <a class="textlink" href={a.href}>Mehr erfahren<span class="visually-hidden">: {a.titel}</span></a>
          </article>
        ))}
      </div>
      <p class="small section-foot">Der Schwerpunkt liegt auf Asset Management, also der wirtschaftlichen Steuerung eines Bestands aus Eigentümersicht. <a href="/property-management-optimierung/">Property Management</a> ist die operative Schnittstelle, <a href="/ki-immobilienmanagement/">KI</a> ein ergänzender Hebel.</p>

      <div class="vertiefungen-block g">
        <div class="gc-1-3">
          <h3 class="caps vertiefungen-block__titel" id="vertiefungen-h">Vertiefungen</h3>
          <p class="small vertiefungen-block__text">Drei Handlungsfelder und der Ablauf einer Zusammenarbeit, jeweils auf einer eigenen Seite erklärt.</p>
        </div>
        <ul class="vertiefungen gc-4-12" role="list" aria-labelledby="vertiefungen-h">
          {vertiefungen.map((v) => (
            <li>
              <a class="textlink" href={v.href}>{v.label}</a>
              <p>{v.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="arbeitsweise">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow eyebrow--still">Arbeitsweise</span>
        <h2>Vier Schritte, die sich am Bestand orientieren, nicht an einer Schablone.</h2>
        <p>Dauer und Tiefe hängen von Portfolio, Datenlage und Zielsetzung ab. Nicht jedes Portfolio braucht eine komplette Neuaufstellung. Oft geht es darum, Bestehendes unabhängig zu prüfen, Prioritäten zu verändern und Maßnahmen konsequent zu organisieren.</p>
      </div>
      <ol class="steps" role="list">
        {schritte.map((s) => (<li><h3>{s.t}</h3><p>{s.d}</p></li>))}
      </ol>
    </div>
  </section>

  <section class="section section--linie" id="ansatz">
    <div class="container g ansatz__grid">
      <div class="gc-1-6 ansatz__media">
        <Portrait nr={2} ratio="3/2" sizes="(max-width: 860px) 100vw, (max-width: 1300px) 48vw, 600px" widths={[640, 960, 1200]} />
      </div>
      <div class="gc-7-12 ansatz__text">
        <span class="eyebrow">Persönlicher Ansatz</span>
        <h2>Ich betrachte Immobilien nicht nur aus der Beratungs&shy;perspektive.</h2>
        <p>Ich halte selbst Immobilien und trage als Vorstand der Müller Holding AG und Geschäftsführer mehrerer Unternehmen unternehmerische Verantwortung. Entscheidungen über Ankauf, Instandhaltung, Finanzierung und Vermietung treffe ich mit eigenem Kapital und eigenem Risiko. Diese Perspektive bringe ich in jedes Mandat ein.</p>
        <p>Über die Hausverwaltung Müller GmbH kenne ich das Tagesgeschäft, in dem Beschlüsse tatsächlich umgesetzt werden müssen. Ein operatives Netzwerk mit Bezügen zu Schreinerei, Fenster- und Elementebau sowie Heizung und Sanitär hilft mir, Machbarkeit, Kosten und Dienstleisterleistungen realistisch einzuschätzen.</p>
        <p>Wie ich arbeite und welche Interessen ich offenlege, steht unter <a href="/zusammenarbeit/#interessen">Zusammenarbeit</a>.</p>
        <a class="textlink" href="/profil/">Zum Profil</a>
      </div>
    </div>
  </section>

  <section class="section section--linie" id="ki">
    <div class="container">
      <div class="abschnitt">
        <div class="abschnitt__kopf sticky-rand">
          <span class="eyebrow eyebrow--still">KI als ergänzender Hebel</span>
          <h2>Bessere Steuerung beginnt mit besseren Infor&shy;mationen.</h2>
          <p>KI ist für mich Werkzeug, kein Selbstzweck. KI hilft dort, wo Daten unvollständig, Vorgänge unübersichtlich und Berichte aufwendig sind. Ergebnisse bleiben prüfbar, Freigaben und Verantwortung bleiben klar geregelt.</p>
        </div>
        <div class="abschnitt__inhalt">
          <ol class="register register--2" role="list">
            {kiFelder.map((k) => (
              <li>
                <h3>{k.t}</h3>
                <p>{k.d}</p>
              </li>
            ))}
          </ol>
          <p class="abschnitt__foot"><a class="textlink" href="/ki-immobilienmanagement/">KI im Immobilienmanagement</a></p>
        </div>
      </div>
    </div>
  </section>

  <Szenario
    id="vorgehen"
    titel={'Einstieg in einen Wohnungsbestand mit mehreren Verwaltungs­einheiten'}
    intro="Referenzfälle würde ich nur mit belegten Ergebnissen und mit Zustimmung des Eigentümers zeigen. Bis dahin zeige ich an einem schematischen Fall, wie ein Einstieg ablaufen würde."
    ausgangslage={[
      'Ein Wohnungsbestand wäre auf mehrere Verwaltungseinheiten verteilt. Jede Einheit würde anders berichten, mit eigenen Listen, eigenen Kennzahlen und eigenem Rhythmus. Ein Vergleich zwischen den Objekten wäre so kaum möglich.',
      'Ein Instandhaltungsstau, also aufgelaufene und nicht ausgeführte Instandhaltung, wäre bekannt, sein Umfang aber nicht belastbar beziffert. Die Eigentümerseite müsste trotzdem über Budget und Reihenfolge entscheiden.',
    ]}
    rolle="Ich würde die Bestandsaufnahme koordinieren, Datenlücken benennen und die Priorisierung mit Verwaltung, Technik und Eigentümerseite moderieren. Entscheidungen blieben beim Eigentümer. Ich würde sie vorbereiten und nachhalten, ob sie umgesetzt werden."
    vorgehen={[
      'Datenbestand zusammenführen: Mieterlisten, Leerstand, offene Forderungen, Instandhaltungshistorie und Verträge aller Verwaltungseinheiten in einen gemeinsamen Stand bringen.',
      'Objekte nach wirtschaftlicher Lage und Handlungsbedarf einordnen und den Instandhaltungsbedarf je Objekt bewerten lassen.',
      'Mit Verwaltung und Technik die größten offenen Themen priorisieren, nach Dringlichkeit, Wirkung und Abhängigkeit.',
      'Maßnahmen mit Verantwortlichen, Budgetrahmen und Terminen hinterlegen und einen einheitlichen Berichtsaufbau für alle Einheiten festlegen.',
    ]}
    beteiligte={['Geschäftsführung oder Eigentümerseite', 'Leitung der Verwaltungseinheiten', 'Technik', 'Rechnungswesen']}
    ergebnisse={[
      'Ein Maßnahmenplan mit Verantwortlichen, Budgetrahmen und Terminen.',
      'Eine Reportingstruktur, die Plan und Ist in festem Rhythmus vergleichbar macht.',
      'Eine Entscheidungsvorlage für die Eigentümerseite zu den wichtigsten Investitionsfragen.',
    ]}
    messung="Gemessen würde die Qualität der Steuerung, nicht ein vorab zugesagter Wert: der Anteil der Maßnahmen mit Bewertung, Verantwortlichem und Termin, die Übereinstimmung der Datenstände zwischen Verwaltung, Rechnungswesen und Eigentümerseite sowie der Plan-Ist-Abgleich je Berichtsperiode."
    grenzen={['Keine Fachplanung, keine Bauleitung.', 'Keine Rechts- oder Steuerberatung.', 'Kein Ersatz der laufenden Verwaltung.', 'Keine Ergebniszusage vor der Bestandsaufnahme.']}
    mehr={{ label: 'Was ein echter Fall zusätzlich braucht', href: '/einblicke/#redaktionsgrundsaetze' }}
    freigabe={referenzfallFreigabe}
  />

  {beitraege.length > 0 && (
    <section class="section" id="einblicke">
      <div class="container">
        <div class="abschnitt">
          <div class="abschnitt__kopf sticky-rand">
            <span class="eyebrow eyebrow--still">Einblicke</span>
            <h2>Aktuelle Einblicke in die Arbeitsweise.</h2>
            <p>Fachbeiträge mit einer Kernaussage, konkreten Arbeitsschritten und benannten Grenzen.</p>
          </div>
          <div class="abschnitt__inhalt">
            <ol class="register register--einblicke" role="list">
              {beitraege.map((b) => (
                <li>
                  {b.data.datum && <time datetime={b.data.datum.toISOString().slice(0, 10)}>{formatDatum(b.data.datum)}</time>}
                  <h3>{b.data.title}</h3>
                  <p>{b.data.kernaussage}</p>
                  <a class="textlink" href={`/einblicke/${b.id}/`}>Beitrag lesen<span class="visually-hidden">: {b.data.title}</span></a>
                </li>
              ))}
            </ol>
            <p class="abschnitt__foot"><a class="textlink" href="/einblicke/">Alle Einblicke</a></p>
          </div>
        </div>
      </div>
    </section>
  )}

  <Cta />
</Base>

<style>
  /* Hero 7/5: Text vor Bild im DOM, damit die H1 mobil auf dem ersten Bildschirm bleibt */
  .hero { padding-block: clamp(2.5rem, 6vw, 6rem) clamp(2.5rem, 5vw, 5rem); border-bottom: 0; }
  .hero__grid { align-items: start; }
  .hero__text { min-width: 0; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-4) var(--s-5); align-items: center; margin-top: var(--s-6); }
  .hero__mail { border-top: var(--rule); padding-top: var(--s-4); margin-top: var(--s-6); color: var(--c-text-2); font-size: var(--fs-small); }
  .hero__mail a { font-weight: 600; color: var(--c-text); }
  /* Display-H1: ab 861 px begrenzt die Spalte gc-1-7 die Zeilenbreite, nicht 18ch (Spezifikation 4.2: Trennung nur bei Bedarf).
     Bei 1440 px stehen so drei Zeilen ohne Trennung (Asset-Management- / Beratung fuer / Immobilienportfolios.),
     in schmaleren Spalten und bei 200 Prozent Zoom greift die weiche Trennstelle weiterhin. */
  @media (min-width: 861px) { .hero .display { max-width: none; } }
  @media (max-width: 860px) { .hero__media { max-width: 20rem; } }
  /* Fuenf-Sekunden-Test bei 360 px (Spezifikation 11.1 Nr. 8, Masterprompt 7A): kompaktere Abstaende und Lead in
     Fliesstextgroesse, damit Name, Thema, Leitzeile, Button und E-Mail auf dem ersten Bildschirm stehen. Haarlinie bleibt. */
  @media (max-width: 640px) {
    .hero { padding-block: var(--s-6); }
    .hero .lead { font-size: var(--fs-body); }
    .hero__actions { margin-top: var(--s-5); }
    .hero__mail { margin-top: var(--s-4); }
  }
  @media (max-width: 480px) { .hero .eyebrow { letter-spacing: 0.04em; } }   /* Eyebrow in zwei statt drei Zeilen */

  /* Fakten-Band: drei Aussagen mit 2 px Linie oben, ohne Kasten */
  .fakten { list-style: none; margin: 0; padding: 0; row-gap: var(--s-5); }

---
import Fachseite from '../layouts/Fachseite.astro';
---
<Fachseite
  path="/portfoliooptimierung/"
  title="Immobilienportfolio optimieren | Timo Müller"
  description="Bestandsoptimierung für Wohnimmobilien: Leerstand, Forderungen, laufende Kosten, Instandhaltungs- und Investitionsprioritäten, Liquidität. Beratung von Timo Müller."
  h1="Portfoliooptimierung für Immobilienbestände"
  eyebrow="Beratung"
  frage="Welche Maßnahmen verbessern Ihr Ergebnis tatsächlich, und in welcher Reihenfolge?"
  intro="Portfoliooptimierung bedeutet hier die konkrete wirtschaftliche und operative Verbesserung eines Bestands: Erträge sichern, Kosten und Ausfälle senken, Investitionen priorisieren und die Liquidität im Blick behalten."
  serviceName="Portfoliooptimierung für Immobilienbestände"
  serviceType="Bestandsoptimierung Immobilien"
  situationen={[
    { t: 'Ergebnis unter Erwartung', d: 'Der Bestand ist grundsätzlich gesund, aber Leerstand, Forderungsausfälle und Kosten drücken das Ergebnis stärker, als es sein müsste.' },
    { t: 'Instandhaltungsstau ohne Zahlenbasis', d: 'Der Umfang des Rückstands ist bekannt, aber nicht beziffert. Investitionen werden reaktiv statt nach Priorität entschieden.' },
    { t: 'Heterogener Bestand nach Zukauf', d: 'Mehrere Teilportfolios mit unterschiedlichen Verwaltungen, Datenständen und Standards sollen einheitlich gesteuert werden.' },
    { t: 'Anstehende Finanzierungsentscheidung', d: 'Prolongation, Umschuldung oder Kapitalbedarf verlangen eine belastbare Darstellung von Ertragskraft und Investitionsbedarf.' },
  ]}
  leistungen={[
    { t: 'Einordnung des Bestands', d: 'Jedes Objekt wird nach Ausgangslage und Handlungsbedarf eingeordnet: Ertragslage, Zustand, Vermietbarkeit, Kapitalbindung. Daraus entsteht eine Landkarte, wo Aufmerksamkeit und Budget wirken.' },
    { t: 'Leerstand und Vermietung', d: 'Ursachen des Leerstands je Einheit klären: Zustand, Preis, Prozess oder Nachfrage. Maßnahmen mit Verwaltung und Technik so abstimmen, dass Freigabe, Herrichtung und Vermarktung ineinandergreifen.' },
    { t: 'Forderungen', d: 'Offene Posten strukturieren, Mahnprozesse und Zuständigkeiten prüfen, realistische Einschätzung von Einbringlichkeit und Aufwand.' },
    { t: 'Laufende Kosten (OPEX)', d: 'OPEX sind die laufenden Betriebs- und Verwaltungskosten. Sie werden nach Umlagefähigkeit, Vertragsbindung und Einflussmöglichkeit geordnet. Dienstleisterverträge und Verbrauchsdaten werden auf Auffälligkeiten geprüft.' },
    { t: 'Instandhaltung und Investitionen (CAPEX)', d: 'CAPEX sind Investitionen in die Substanz: Dach, Fassade, Technik, Wohnungen. Ich unterstütze bei der Priorisierung nach Dringlichkeit, Wirkung auf Ertrag und Wert sowie technischer Abhängigkeit, und bei der Umsetzungsplanung.' },
    { t: 'Liquidität und Finanzierungsschnittstelle', d: 'Maßnahmenplan und Liquiditätsplanung werden zusammengeführt. Für Gespräche mit Finanzierern entstehen nachvollziehbare Unterlagen zu Ertragskraft, Investitionsbedarf und Zeitplan. Die Finanzierung selbst vermittle ich nicht.' },
  ]}
  ergebnisse={[
    'Portfolio-Einordnung mit Handlungsbedarf je Objekt',
    'Maßnahmenliste nach Wirkung, Aufwand und Risiko priorisiert',
    'CAPEX-Plan mit Zeitachse und Budgetrahmen',
    'Maßnahmenpaket Leerstand und Forderungen mit Verantwortlichen',
    'Abgestimmte Kennzahlen für die laufende Nachverfolgung',
  ]}
  vorgehen={[
    { t: 'Daten zusammenführen', d: 'Mieterlisten, Leerstand, offene Forderungen, Kosten, Instandhaltungshistorie und Verträge in einen konsistenten Stand bringen.' },
    { t: 'Objekte einordnen', d: 'Ertragslage, Zustand und Handlungsbedarf je Objekt bewerten, Cluster bilden.' },
    { t: 'Maßnahmen priorisieren', d: 'Mit Eigentümerseite, Verwaltung und Technik die Reihenfolge festlegen und Verantwortliche benennen.' },
    { t: 'Umsetzen und nachhalten', d: 'Fortschritt und Wirkung monatlich prüfen, Abweichungen erklären, nachsteuern.' },
  ]}
  abgrenzung={[
    'Zahlenbeispiele in Vorlagen basieren auf offen gelegten Modellannahmen. Sie sind keine Projektergebnisse und keine Zusage.',
    'Ich vermittle keine Finanzierungen und erbringe keine Anlageberatung. Ich bereite die Unterlagen vor und begleite fachlich.',
    'Die operative Umsetzung erfolgt durch Ihre Verwaltung und Dienstleister. Ich steuere und halte nach, ersetze diese aber nicht.',
  ]}
  faq={[
    { q: 'Wie schnell zeigen sich Verbesserungen?', a: 'Das hängt von Ausgangslage, Datenqualität und Entscheidungsgeschwindigkeit ab. Maßnahmen bei Forderungen und Prozessen wirken meist früher als Investitionen in die Substanz. Ich nenne keine pauschalen Fristen oder Einsparquoten.' },
    { q: 'Brauchen Sie Zugang zu allen Daten?', a: 'Für eine Ersteinschätzung genügen aggregierte Angaben. Im Mandat arbeite ich mit den Daten, die für die vereinbarten Handlungsfelder erforderlich sind. Vertraulichkeit wird vorab vereinbart.' },
    { q: 'Was passiert mit der bestehenden Verwaltung?', a: 'Sie bleibt eingebunden. Portfoliooptimierung funktioniert nur, wenn die Verwaltung die Maßnahmen im Tagesgeschäft trägt. Ein Verwalterwechsel ist kein Ziel der Beratung, kann aber ein Ergebnis der Analyse sein.' },
    { q: 'Wie unterscheiden sich CAPEX und OPEX in der Steuerung?', a: 'OPEX beeinflussen das laufende Ergebnis und sind teilweise umlagefähig. CAPEX binden Kapital, erhöhen aber Substanz, Vermietbarkeit und Wert. Beide werden getrennt geplant und gemeinsam in der Liquidität betrachtet.' },
  ]}
  verwandt={[
    { label: 'Asset-Management-Beratung', href: '/asset-management-beratung/' },
    { label: 'Property-Management-Optimierung', href: '/property-management-optimierung/' },
    { label: 'KI im Immobilienmanagement', href: '/ki-immobilienmanagement/' },
  ]}
/>
